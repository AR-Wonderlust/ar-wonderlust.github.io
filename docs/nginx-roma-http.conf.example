# Sitio independiente. Confirmar dominio y DNS antes de instalar.
limit_req_zone $binary_remote_addr zone=roma_ip:10m rate=6r/m;
limit_req_zone $server_name zone=roma_total:1m rate=20r/m;
server {
    listen 80;
    server_name asistente.somosromaturismo.com;
    client_max_body_size 24k;
    location / {
        limit_req zone=roma_ip burst=6 nodelay;
        limit_req zone=roma_total burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8010;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
        access_log off;
    }
}
