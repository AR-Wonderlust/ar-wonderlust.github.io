{
  "name": "ROMA · Cola CRM (prueba sin mensajes)",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "manual",
      "name": "Prueba manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Cada cinco minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://crm-admin:8000/automation/events/claim",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "id": "claim",
      "name": "Reclamar eventos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const batch = $input.first().json; return (batch.events || []).map(event => ({json: {...event, lease_token: batch.lease_token}}));"
      },
      "id": "split",
      "name": "Separar eventos (sin acciones externas)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        490,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://crm-admin:8000/automation/events/{{$json.id}}/ack",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({lease_token: $json.lease_token}) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "ack",
      "name": "Confirmar prueba procesada",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        750,
        80
      ]
    }
  ],
  "connections": {
    "Prueba manual": {
      "main": [
        [
          {
            "node": "Reclamar eventos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cada cinco minutos": {
      "main": [
        [
          {
            "node": "Reclamar eventos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reclamar eventos": {
      "main": [
        [
          {
            "node": "Separar eventos (sin acciones externas)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Separar eventos (sin acciones externas)": {
      "main": [
        [
          {
            "node": "Confirmar prueba procesada",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
